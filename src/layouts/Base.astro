---
// 共用的 HTML 外框：<head> 設定、標題列、對話框、提示訊息
// 每一頁都包在這個 Layout 裡面。
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';
import { t } from '../i18n/index.js';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title = `${t('app.name')}｜${t('app.tagline')}`, description = t('app.tagline'), lang = 'zh-Hant-TW', jsonLd } = Astro.props;
// BASE_URL 是 astro.config.mjs 裡的 base（GitHub Pages 是 /packing-list/）
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- 注意：不要加 user-scalable=no / maximum-scale，讓視力不好的人可以放大 -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a6b7a" />
    <title>{title}</title>
    <SeoHead title={title} description={description} jsonLd={jsonLd} />
    <meta name="application-name" content={t('app.name')} />
    <meta name="apple-mobile-web-app-title" content={t('app.name')} />
    <link rel="icon" type="image/svg+xml" href={`${base}icons/icon.svg`} />
    <link rel="apple-touch-icon" href={`${base}icons/icon-192.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
  </head>
  <body>
    <header class="topbar no-print">
      <button type="button" id="back-btn" class="topbar-back" hidden>{t('trip.back')}</button>
      <a class="topbar-title" href={`${base}zh-tw/#/`}>🧳 {t('app.name')}</a>
    </header>
    <main id="app"><slot /></main>
    <footer class="footer no-print"><p>{t('footer.about')}</p><p><a href={`${base}zh-tw/blog/`}>📖 旅行文章：日本行李清單、打包技巧、入境教學</a></p><p class="footer-links"><a href={`${base}zh-tw/about/`}>關於我</a> ・ <a href={`${base}zh-tw/privacy/`}>隱私權政策</a> ・ <a href={`${base}zh-tw/blog/disclosure/`}>推廣連結揭露</a></p></footer>
    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
    <dialog id="dialog" class="dialog"></dialog>
    <script define:vars={{ swUrl: `${base}sw.js`, isProd: import.meta.env.PROD }}>
      // 註冊 Service Worker：讓網站在沒網路時（飛機上）也能打開。開發模式不註冊，避免快取干擾。
      if (isProd && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register(swUrl).catch(() => {}));
      }
    </script>
  </body>
</html>
