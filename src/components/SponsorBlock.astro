---
// 贊助（請喝咖啡）區塊：放在每篇文章最後、和 /zh-tw/sponsor/ 頁面。
// ⚠️ 金額是「範例金額，未定」，只在 src/data/sponsor.json 改。後端會再檢查金額（整數、上下限）。
// 按鈕預設停用；build 時設 PUBLIC_PAYMENT_ENABLED=1 才能按。
// build 時設 PUBLIC_SPONSOR_HIDE=1 → 整個區塊不顯示（例如送藍新審核時，見 docs/newebpay.md §9）。
// 用詞規則：只用「贊助」「請喝咖啡」。
import sponsor from '../data/sponsor.json';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const enabled = import.meta.env.PUBLIC_PAYMENT_ENABLED === '1';
const hidden = import.meta.env.PUBLIC_SPONSOR_HIDE === '1';
const uid = `sp${Math.random().toString(36).slice(2, 8)}`;
---
{!hidden && (
<section class:list={['sponsor', { compact }]} aria-labelledby={`${uid}-title`}>
  <h2 id={`${uid}-title`}>☕ {sponsor.title}</h2>
  <p>{sponsor.blurb}</p>
  <p class="sponsor-note">{sponsor.voluntaryNote}</p>
  <form class="sponsor-form" data-min={sponsor.minTwd} data-max={sponsor.maxTwd} novalidate>
    <fieldset>
      <legend>選擇金額（新台幣）<span class="sponsor-tag">{sponsor.sampleNote}</span></legend>
      <div class="sponsor-amounts">
        {sponsor.presetsTwd.map((n) => (
          <label class="sponsor-chip"><input type="radio" name="preset" value={n} checked={n === sponsor.defaultTwd} disabled={!enabled} /> NT$ {n}</label>
        ))}
        <label class="sponsor-chip"><input type="radio" name="preset" value="custom" disabled={!enabled} /> 自訂</label>
      </div>
      <label class="sponsor-custom">自訂金額（整數，NT$ {sponsor.minTwd}–{sponsor.maxTwd}）
        <input type="number" name="custom" inputmode="numeric" step="1" min={sponsor.minTwd} max={sponsor.maxTwd} placeholder={String(sponsor.defaultTwd)} disabled={!enabled} />
      </label>
    </fieldset>
    <label class="sponsor-agree"><input type="checkbox" name="agree" required disabled={!enabled} /> 我了解贊助是自願的，不會收到任何商品或服務；並已閱讀 <a href={`${base}zh-tw/refund/#sponsor`}>退款政策（贊助）</a> 與 <a href={`${base}zh-tw/terms/#sponsor`}>服務條款</a>。</label>
    <button type="submit" class="btn" disabled={!enabled}>{enabled ? '前往藍新金流付款（測試環境）' : '尚未開放贊助'}</button>
    <p class="sponsor-msg" role="status" aria-live="polite"></p>
    <p class="sponsor-fine">付款由第三方支付「藍新金流 NewebPay」處理（信用卡），本網站不會經手或儲存你的卡號。</p>
  </form>
</section>
)}
<script>
  // 贊助按鈕：先請後端建立訂單（後端檢查金額），再用 HTML Form Post 送到藍新（藍新規定要前景 Form Post）。
  document.querySelectorAll<HTMLFormElement>('.sponsor-form').forEach((form) => {
    const custom = form.querySelector<HTMLInputElement>('input[name="custom"]')!;
    custom.addEventListener('focus', () => {
      const r = form.querySelector<HTMLInputElement>('input[name="preset"][value="custom"]');
      if (r) r.checked = true;
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLElement>('.sponsor-msg')!;
      const btn = form.querySelector<HTMLButtonElement>('button')!;
      const fd = new FormData(form);
      const preset = String(fd.get('preset') || '');
      const raw = preset === 'custom' ? String(fd.get('custom') || '').trim() : preset;
      const min = Number(form.dataset.min);
      const max = Number(form.dataset.max);
      if (!/^\d+$/.test(raw) || Number(raw) < min || Number(raw) > max) {
        msg.textContent = `請輸入 NT$ ${min}–${max} 的整數金額`;
        return;
      }
      if (fd.get('agree') !== 'on') {
        msg.textContent = '請先勾選：我了解贊助是自願的，不會收到任何商品或服務';
        return;
      }
      btn.disabled = true;
      msg.textContent = '建立訂單中…';
      try {
        const res = await fetch('/api/newebpay/sponsor/create/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ amount: raw, agree: true }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.message || data.error || '建立訂單失敗');
        const out = document.createElement('form');
        out.method = 'POST';
        out.action = data.action;
        for (const [k, v] of Object.entries(data.fields as Record<string, string>)) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = k;
          input.value = v;
          out.appendChild(input);
        }
        document.body.appendChild(out);
        out.submit();
      } catch (err) {
        msg.textContent = `無法前往付款：${(err as Error).message}`;
        btn.disabled = false;
      }
    });
  });
</script>
<style>
  .sponsor { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; margin: 24px 0; }
  .sponsor h2 { margin: 0 0 6px; font-size: 1.15rem; color: var(--accent); }
  .sponsor p { margin: 6px 0; }
  .sponsor-note { font-size: .9rem; background: var(--accent-soft); border-radius: 10px; padding: 8px 10px; }
  .sponsor-form { display: grid; gap: 10px; font-size: .92rem; }
  .sponsor fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .sponsor legend { font-weight: 700; margin-bottom: 6px; }
  .sponsor-tag { display: inline-block; margin-left: 8px; background: var(--gold-soft); color: #5a3e00; border-radius: 6px; padding: 1px 8px; font-size: .78rem; font-weight: 700; }
  .sponsor-amounts { display: flex; flex-wrap: wrap; gap: 8px; }
  .sponsor-chip { display: inline-flex; align-items: center; gap: 6px; min-height: var(--tap); padding: 0 12px; border: 1px solid var(--border); border-radius: 999px; cursor: pointer; }
  .sponsor-custom input { display: block; width: 100%; max-width: 220px; min-height: var(--tap); margin-top: 4px; padding: 6px 10px; border: 1px solid var(--border); border-radius: 10px; font: inherit; }
  .sponsor .btn { min-height: var(--tap); border: 0; border-radius: 10px; background: var(--accent); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .sponsor .btn:disabled { background: var(--border); color: var(--text-sub); cursor: not-allowed; }
  .sponsor-msg { margin: 0; color: var(--danger); min-height: 1em; }
  .sponsor-fine { font-size: .82rem; color: var(--text-sub); }
</style>
